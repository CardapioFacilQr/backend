# Copie para .env para rodar localmente com `npm run start:dev`.
# (O banco pode ser o do docker-compose.dev.yml, exposto em localhost:5432.)

PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=cardapio
DB_PASSWORD=68fe78cfa0ce2d43cecffdfd4b82bfecdd01a9418287a549
DB_NAME=cardapio
# true apenas em desenvolvimento (cria/atualiza as tabelas automaticamente)
DB_SYNCHRONIZE=true
# Opcionais: tentativas de reconexão ao banco na inicialização
# DB_RETRY_ATTEMPTS=10
# DB_RETRY_DELAY_MS=3000

JWT_SECRET=dfshubwufweeubejbe7332b23
JWT_EXPIRES_IN=1d

# URL pública onde a API responde; usada para montar a URL do QR Code (${PUBLIC_BASE_URL}/m/<slug>)
PUBLIC_BASE_URL=http://localhost:3000

# Padrão: /app/uploads em produção e ./uploads fora dela
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# "*" ou lista separada por vírgula: https://meusite.com,https://admin.meusite.com
CORS_ORIGIN=*

# Em produção, senhas podem vir de arquivos (Docker secrets):
# DB_PASSWORD_FILE=/run/secrets/cardapio_db_password
# JWT_SECRET_FILE=/run/secrets/cardapio_jwt_secret
